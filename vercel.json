{
  "$schema": "https://vercel.sh",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "readit": {
      "root": "Readit",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/notes(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "readit"
      }
    }
  ]
}   